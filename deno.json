{
  "name": "@christiansmith/mapper-http",
  "version": "0.3.1",
  "license": "MIT",
  "exports": "./src/index.js",
  "nodeModulesDir": "none",
  "publish": {
    "exclude": ["test", "run.js", ".prettierrc", "mappings", "extensions", "Dockerfile", ".dockerignore", ".github"]
  },
  "imports": {
    "@christiansmith/mapper-js": "jsr:@christiansmith/mapper-js@^0.3.2",
    "@christiansmith/mapper-request": "jsr:@christiansmith/mapper-request@^0.3.0",
    "jose": "npm:jose@^5",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "tasks": {
    "dev": "OPTIONS='{\"cors\":{\"origin\":\"*\"},\"logging\":{\"format\":\"pretty\"}}' deno run --allow-net --allow-env --allow-read run.js",
    "test": "deno test --allow-net --allow-read"
  }
}
